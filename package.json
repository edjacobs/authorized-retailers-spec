{
  "name": "@authorizedretailers/spec",
  "version": "0.1.0",
  "description": "Authorized Retailers v0.1: JSON Schemas, types, validator, identifier matching, RFC 8785 canonicalization and detached-JWS reference verifier",
  "license": "Apache-2.0",
  "author": "Authorized Retailers",
  "homepage": "https://authorizedretailers.ai/spec",
  "repository": { "type": "git", "url": "git+https://github.com/authorizedretailers/spec.git" },
  "bugs": "https://github.com/authorizedretailers/spec/issues",
  "keywords": ["authorized-retailers", "ai-agents", "agentic-commerce", "brand-protection", "jws", "json-schema"],
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./jws": { "types": "./dist/jws.d.ts", "default": "./dist/jws.js" },
    "./jcs": { "types": "./dist/jcs.d.ts", "default": "./dist/jcs.js" },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*",
    "./spec.md": "./spec/spec-v0.1.md",
    "./package.json": "./package.json"
  },
  "files": ["dist", "schemas", "fixtures", "spec", "LICENSE", "LICENSE-docs"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:dist": "npm run build && node test/dist-smoke.mjs",
    "typecheck": "tsc -p .",
    "check:package": "npm run build && attw --pack . --profile esm-only --exclude-entrypoints ./spec.md",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:dist"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
