{
  "name": "@authorizedretailers/spec",
  "version": "0.7.1",
  "description": "authorized-retailers.json v0.7, an open format with a single registry: JSON Schemas, types, validator, identifier and product matching, RFC 8785 canonicalization and detached-JWS reference verifier",
  "license": "Apache-2.0 AND CC-BY-4.0",
  "author": "Authorized Retailers LLC",
  "homepage": "https://authorizedretailers.ai/spec",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edjacobs/authorized-retailers-spec.git"
  },
  "bugs": "https://authorizedretailers.ai/spec",
  "keywords": [
    "authorized-retailers",
    "authorized-retailers-json",
    "ai-agents",
    "agentic-commerce",
    "brand-protection",
    "json-schema",
    "jws",
    "verification"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jws": {
      "types": "./dist/jws.d.ts",
      "default": "./dist/jws.js"
    },
    "./jcs": {
      "types": "./dist/jcs.d.ts",
      "default": "./dist/jcs.js"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*",
    "./spec.md": "./spec/spec-v0.7.md",
    "./package.json": "./package.json",
    "./spec/*": "./spec/*"
  },
  "files": [
    "dist",
    "schemas",
    "fixtures",
    "spec",
    "LICENSE",
    "LICENSE-SPEC"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "schemas": "node scripts/embed-schemas.mjs",
    "test": "vitest run",
    "test:dist": "npm run build && node test/dist-smoke.mjs",
    "typecheck": "tsc -p .",
    "check:cadence": "node scripts/check-release-cadence.mjs",
    "check:package": "npm run build && attw --pack . --profile esm-only --exclude-entrypoints ./spec.md",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:dist"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
